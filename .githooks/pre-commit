#!/bin/sh
# Blocks other products' names in added lines (scripts/check_content.py).
# Blocks an oversized docs/progress.md (scripts/check_progress_size.py).
# Prints a note for long source files (scripts/check_size.py); it never blocks.
. "$(dirname "$0")/find-python.sh"
"$PY" "$top/scripts/check_size.py"
"$PY" "$top/scripts/check_progress_size.py" || exit 1
exec "$PY" "$top/scripts/check_content.py" --staged
